# SSH Client Configuration
# Copy this file to ~/.ssh/config to use

# Include modular configuration files from ~/.config/ssh/config.d/
# Note: config.d is the standard naming convention (not conf.d)
Include ~/.config/ssh/config.d/*.conf

# Add any personal host configurations below
# Example:
# Host myserver
#     Hostname server.example.com
#     User myusername
#     Port 2222
