[init]
	defaultBranch = trunk
#	templateDir = ${XDG_CONFIG_HOME}/git/templates
[push]
	autoSetupRemote = true
[pull]
	ff = only
#	rebase = true
[color]
	ui = auto
[user]
	useConfigOnly = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[rerere]
	enabled = true

# Conditionally include container-use config for GitHub repositories
# Matches both SSH (git@github.com:*/*) and HTTPS (https://github.com/*) remotes
[includeIf "hasconfig:remote.*.url:**github.com**"]
	path = ~/.config/git/container-use.config
